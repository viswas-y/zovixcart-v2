# Next.js - Sanity Client Environment Variables
# Copy this file to .env.local and fill in your Sanity project details

NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Server-only: Sanity API write token for creating customer orders
# Generate in sanity.io/manage under Project > API > Tokens (Editor permissions)
SANITY_API_WRITE_TOKEN=your_sanity_write_token_here
